{
  "openapi": "3.1.0",
  "info": {
    "title": "MarketMitra API",
    "version": "1.0.0",
    "description": "Public + session-scoped HTTP API for the MarketMitra dashboard. For automated / agent access to public market data, prefer the MCP server at /api/mcp (see /llms.txt and docs/api-surface.md). Session-scoped endpoints authenticate via the Clerk session cookie in hosted mode; in self-host mode they resolve to a single local user with no login."
  },
  "servers": [
    {
      "url": "https://marketmitra-v2.vercel.app",
      "description": "Production"
    },
    {
      "url": "http://localhost:3000",
      "description": "Local dev"
    }
  ],
  "tags": [
    {
      "name": "Market data",
      "description": "Public. Also available as MCP tools at /api/mcp."
    },
    {
      "name": "Portfolio",
      "description": "Session-scoped. The signed-in user's holdings."
    },
    {
      "name": "Alerts",
      "description": "Session-scoped. Price / %-move / 52w / portfolio / IPO alerts."
    },
    {
      "name": "Notifications",
      "description": "Session-scoped. In-app notification centre."
    },
    {
      "name": "AI",
      "description": "Session-scoped. BYO-key AI insights + chat. 400 no_ai_key when the user has no key."
    },
    {
      "name": "Settings",
      "description": "Session-scoped. The user's encrypted AI provider key."
    },
    {
      "name": "System",
      "description": "Machine-to-machine / infrastructure."
    }
  ],
  "components": {
    "securitySchemes": {
      "cookieAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__session",
        "description": "Clerk session cookie (hosted mode). Sent automatically by the browser; the API explorer uses your current session."
      },
      "cronBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "CRON_SECRET bearer token."
      }
    },
    "schemas": {
      "Envelope": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "data": {},
          "error": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  },
  "paths": {
    "/api/search": {
      "get": {
        "tags": [
          "Market data"
        ],
        "summary": "Search NSE symbols",
        "description": "Live search across ~2,570 NSE equities + tracked indices. Proxies fundamentals-api; returns the array directly (not the standard envelope).",
        "security": [],
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            },
            "example": "reliance"
          }
        ],
        "responses": {
          "200": {
            "description": "Up to 15 matches, index matches first.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "enum": [
                          "company",
                          "index"
                        ]
                      },
                      "symbol": {
                        "type": "string"
                      },
                      "name": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/stock/{ticker}": {
      "get": {
        "tags": [
          "Market data"
        ],
        "summary": "Get everything about a ticker",
        "description": "Screener.in-style aggregate for one NSE company in a single call: company profile, a live quote (ADR 0024: yahoo-finance2, falling back to NSE/BSE), ratios, shareholding pattern, peer comparison, document links, and financial statements. Pick `sections` to narrow the response. Returns the object directly (not the standard envelope) \u2014 same deliberate exception as GET /api/search and GET /api/news. Shares its aggregation logic with the MCP `get_company_fundamentals` tool.",
        "security": [],
        "parameters": [
          {
            "name": "ticker",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "RELIANCE"
          },
          {
            "name": "sections",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Comma-separated subset of: company, quote, ratios, shareholding, peers, documents, financials. Omit for all.",
            "example": "company,quote,ratios"
          }
        ],
        "responses": {
          "200": {
            "description": "{ symbol, found: true, company?, quote?, ratios?, shareholding?, peers?, documents?, financials? } \u2014 fields present per `sections`."
          },
          "400": {
            "description": "Unknown value in `sections`."
          },
          "404": {
            "description": "{ symbol, found: false, message } \u2014 not a symbol the fundamentals service recognises, or every source came up short."
          }
        }
      }
    },
    "/api/news": {
      "get": {
        "tags": [
          "Market data"
        ],
        "summary": "Market news feed",
        "description": "Recent Indian-markets headlines. Omit `symbols` for the broad stream. `sentiment` is headline tone, not a signal. Page with `cursor` from `next_cursor`.",
        "security": [],
        "parameters": [
          {
            "name": "symbols",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Comma-separated NSE symbols.",
            "example": "RELIANCE,TCS"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 20
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A page of news items.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    },
                    "next_cursor": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/holdings": {
      "get": {
        "tags": [
          "Portfolio"
        ],
        "summary": "List holdings",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "The user's holdings.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated."
          }
        }
      },
      "post": {
        "tags": [
          "Portfolio"
        ],
        "summary": "Add a holding",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "symbol",
                  "quantity",
                  "avgPrice"
                ],
                "properties": {
                  "symbol": {
                    "type": "string"
                  },
                  "quantity": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "avgPrice": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                }
              },
              "example": {
                "symbol": "RELIANCE",
                "quantity": 10,
                "avgPrice": 2450.5
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created."
          },
          "401": {
            "description": "Not authenticated."
          },
          "422": {
            "description": "Invalid input."
          }
        }
      }
    },
    "/api/holdings/{id}": {
      "patch": {
        "tags": [
          "Portfolio"
        ],
        "summary": "Update a holding",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "quantity": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "avgPrice": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                }
              },
              "example": {
                "quantity": 15,
                "avgPrice": 2500
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated."
          },
          "401": {
            "description": "Not authenticated."
          },
          "404": {
            "description": "Not found / not owned."
          }
        }
      },
      "delete": {
        "tags": [
          "Portfolio"
        ],
        "summary": "Delete a holding",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Deleted."
          },
          "401": {
            "description": "Not authenticated."
          },
          "404": {
            "description": "Not found / not owned."
          }
        }
      }
    },
    "/api/notes": {
      "get": {
        "tags": [
          "Portfolio"
        ],
        "summary": "List notes",
        "description": "The user's saved notes (Phase 10 / ADR 0020), newest-updated first. Notes also feed the user's private retrieval corpus.",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "The user's notes.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated."
          }
        }
      },
      "post": {
        "tags": [
          "Portfolio"
        ],
        "summary": "Create a note",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "title",
                  "body"
                ],
                "properties": {
                  "title": {
                    "type": "string",
                    "maxLength": 140
                  },
                  "body": {
                    "type": "string",
                    "maxLength": 4000
                  },
                  "symbol": {
                    "type": "string",
                    "nullable": true
                  }
                }
              },
              "example": {
                "title": "Why I hold TCS",
                "body": "Steady dividend, strong order book.",
                "symbol": "TCS"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created."
          },
          "401": {
            "description": "Not authenticated."
          },
          "409": {
            "description": "Per-user note limit (200) reached."
          },
          "422": {
            "description": "Invalid input."
          }
        }
      }
    },
    "/api/notes/{id}": {
      "patch": {
        "tags": [
          "Portfolio"
        ],
        "summary": "Update a note",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "title",
                  "body"
                ],
                "properties": {
                  "title": {
                    "type": "string"
                  },
                  "body": {
                    "type": "string"
                  },
                  "symbol": {
                    "type": "string",
                    "nullable": true
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated."
          },
          "401": {
            "description": "Not authenticated."
          },
          "404": {
            "description": "Not found / not owned."
          }
        }
      },
      "delete": {
        "tags": [
          "Portfolio"
        ],
        "summary": "Delete a note",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Deleted."
          },
          "401": {
            "description": "Not authenticated."
          },
          "404": {
            "description": "Not found / not owned."
          }
        }
      }
    },
    "/api/alerts": {
      "get": {
        "tags": [
          "Alerts"
        ],
        "summary": "List alerts",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "All the user's alerts, newest first."
          },
          "401": {
            "description": "Not authenticated."
          }
        }
      },
      "post": {
        "tags": [
          "Alerts"
        ],
        "summary": "Create an alert (or upsert the IPO watch)",
        "description": "Body is a discriminated union on `type`: price_threshold | percent_move | week52_breach | portfolio_pnl | ipo | ipo_watch. `ipo_watch` is upserted (one per user) and returns 200.",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              },
              "example": {
                "type": "price_threshold",
                "symbol": "TCS",
                "params": {
                  "direction": "above",
                  "price": 4200
                },
                "note": "watch breakout",
                "rearm": false
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created."
          },
          "200": {
            "description": "IPO watch upserted."
          },
          "401": {
            "description": "Not authenticated."
          },
          "422": {
            "description": "Invalid input."
          }
        }
      }
    },
    "/api/alerts/{id}": {
      "patch": {
        "tags": [
          "Alerts"
        ],
        "summary": "Update an alert",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              },
              "example": {
                "status": "paused"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated."
          },
          "401": {
            "description": "Not authenticated."
          },
          "404": {
            "description": "Not found."
          },
          "422": {
            "description": "Invalid input."
          }
        }
      },
      "delete": {
        "tags": [
          "Alerts"
        ],
        "summary": "Delete an alert",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Deleted."
          },
          "401": {
            "description": "Not authenticated."
          },
          "404": {
            "description": "Not found."
          }
        }
      }
    },
    "/api/notifications": {
      "get": {
        "tags": [
          "Notifications"
        ],
        "summary": "List notifications",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Notifications + `meta.unread`."
          },
          "401": {
            "description": "Not authenticated."
          }
        }
      }
    },
    "/api/notifications/read": {
      "post": {
        "tags": [
          "Notifications"
        ],
        "summary": "Mark notification(s) read",
        "description": "`{id}` marks one; `{}` or `{all:true}` marks all.",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "all": {
                    "type": "boolean"
                  }
                }
              },
              "example": {
                "all": true
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK."
          },
          "401": {
            "description": "Not authenticated."
          }
        }
      }
    },
    "/api/settings/ai": {
      "get": {
        "tags": [
          "Settings"
        ],
        "summary": "Get AI key status",
        "description": "Never returns the key \u2014 only provider, model, and a last-4 hint.",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Key status view (or null)."
          },
          "401": {
            "description": "Not authenticated."
          }
        }
      },
      "put": {
        "tags": [
          "Settings"
        ],
        "summary": "Set the AI provider key",
        "description": "Validates the key with a live call before storing it. 503 without SETTINGS_ENC_KEY on the server.",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "provider",
                  "apiKey"
                ],
                "properties": {
                  "provider": {
                    "type": "string",
                    "enum": [
                      "gemini",
                      "anthropic",
                      "openrouter"
                    ]
                  },
                  "apiKey": {
                    "type": "string"
                  },
                  "model": {
                    "type": "string"
                  }
                }
              },
              "example": {
                "provider": "gemini",
                "apiKey": "AIza...",
                "model": ""
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Saved."
          },
          "400": {
            "description": "Provider rejected the key."
          },
          "401": {
            "description": "Not authenticated."
          },
          "503": {
            "description": "SETTINGS_ENC_KEY not configured."
          }
        }
      },
      "delete": {
        "tags": [
          "Settings"
        ],
        "summary": "Remove the stored AI key",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Removed."
          },
          "401": {
            "description": "Not authenticated."
          }
        }
      }
    },
    "/api/insights/stock": {
      "post": {
        "tags": [
          "AI"
        ],
        "summary": "Generate / fetch a stock insight",
        "description": "Neutral synthesis of a company's public fundamentals. Per-user cache, 24h. Requires the user's own AI key. Rate limited (ai tier).",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "symbol"
                ],
                "properties": {
                  "symbol": {
                    "type": "string"
                  },
                  "force": {
                    "type": "boolean"
                  }
                }
              },
              "example": {
                "symbol": "RELIANCE"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Insight text + metadata."
          },
          "400": {
            "description": "no_ai_key."
          },
          "401": {
            "description": "Not authenticated."
          },
          "429": {
            "description": "Rate limited."
          }
        }
      }
    },
    "/api/insights/portfolio": {
      "post": {
        "tags": [
          "AI"
        ],
        "summary": "Generate / fetch a portfolio insight",
        "description": "Neutral synthesis of the user's holdings. Per-user cache, 6h. 400 with no holdings. Rate limited (ai tier).",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "force": {
                    "type": "boolean"
                  }
                }
              },
              "example": {}
            }
          }
        },
        "responses": {
          "200": {
            "description": "Insight text + metadata."
          },
          "400": {
            "description": "no_ai_key or no holdings."
          },
          "401": {
            "description": "Not authenticated."
          },
          "429": {
            "description": "Rate limited."
          }
        }
      }
    },
    "/api/insights/ipo": {
      "post": {
        "tags": [
          "AI"
        ],
        "summary": "Generate / fetch an IPO brief",
        "description": "Neutral synthesis of one IPO's public data. Cross-user shared cache keyed by slug, 12h. May use the operator key. Rate limited (ai tier).",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "slug"
                ],
                "properties": {
                  "slug": {
                    "type": "string"
                  },
                  "force": {
                    "type": "boolean"
                  }
                }
              },
              "example": {
                "slug": "example-ipo"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Brief text + metadata."
          },
          "400": {
            "description": "no_ai_key."
          },
          "401": {
            "description": "Not authenticated."
          },
          "429": {
            "description": "Rate limited."
          }
        }
      }
    },
    "/api/research": {
      "post": {
        "tags": [
          "AI"
        ],
        "summary": "Generate a research brief (Phase 10b)",
        "description": "A longer structured brief (markdown sections: what it is / recent developments / the numbers / risks / open questions), retrieval + synthesis. Subject is one of company | theme | portfolio | comparison. Requires the user's own AI key. Not cached (ephemeral). Rate limited (ai tier).",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "subject"
                ],
                "properties": {
                  "subject": {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "enum": [
                          "company",
                          "theme",
                          "portfolio",
                          "comparison"
                        ]
                      },
                      "symbol": {
                        "type": "string"
                      },
                      "symbols": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        },
                        "minItems": 2,
                        "maxItems": 4
                      },
                      "text": {
                        "type": "string"
                      }
                    }
                  }
                }
              },
              "example": {
                "subject": {
                  "type": "company",
                  "symbol": "RELIANCE"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "{ content (markdown), model, generatedAt }."
          },
          "400": {
            "description": "no_ai_key or no holdings."
          },
          "401": {
            "description": "Not authenticated."
          },
          "422": {
            "description": "Invalid subject."
          },
          "502": {
            "description": "Bad symbol / generation failed."
          },
          "429": {
            "description": "Rate limited."
          }
        }
      }
    },
    "/api/agents/run": {
      "post": {
        "tags": [
          "AI"
        ],
        "summary": "Start a multi-agent analysis run (Phase 11)",
        "description": "Kicks off an async, checkpointed run over one stock: analyst team \u2192 bull/bear debate \u2192 synthesis (ADR 0021). ~15\u201320 LLM calls on the caller's own key over a few minutes. Returns immediately with a run id to poll. One run in flight per user. No trade decision is ever produced \u2014 the output is a debated analytical briefing.",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "symbol"
                ],
                "properties": {
                  "symbol": {
                    "type": "string"
                  }
                }
              },
              "example": {
                "symbol": "RELIANCE"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "{ id } \u2014 poll GET /api/agents/run/{id}."
          },
          "400": {
            "description": "no_ai_key."
          },
          "401": {
            "description": "Not authenticated."
          },
          "409": {
            "description": "A run is already in progress for this user."
          },
          "422": {
            "description": "Invalid symbol."
          },
          "429": {
            "description": "Rate limited."
          },
          "502": {
            "description": "Symbol did not resolve."
          }
        }
      }
    },
    "/api/agents/run/{id}": {
      "get": {
        "tags": [
          "AI"
        ],
        "summary": "Poll a multi-agent run",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "{ status, phase, briefing?, error?, ... } \u2014 owner-scoped."
          },
          "401": {
            "description": "Not authenticated."
          },
          "404": {
            "description": "Not found / not owned."
          }
        }
      }
    },
    "/api/agents/tick": {
      "post": {
        "tags": [
          "System"
        ],
        "summary": "Advance one phase of one agent run",
        "description": "Machine-to-machine. Bearer CRON_SECRET (dev-open, prod-503). Claims the oldest resumable run (or `?id=`), runs one phase, persists, and re-invokes itself until done. `.github/workflows/agents-tick.yml` calls it every 5 min as a safety net for dropped self-calls.",
        "security": [
          {
            "cronBearer": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Target one run instead of the sweep."
          }
        ],
        "responses": {
          "200": {
            "description": "{ picked, id?, phase?, status?, done? }"
          },
          "401": {
            "description": "Bad / missing bearer."
          },
          "503": {
            "description": "CRON_SECRET not set (production)."
          }
        }
      }
    },
    "/api/ai/chat": {
      "post": {
        "tags": [
          "AI"
        ],
        "summary": "Mitra chat (streamed, agentic)",
        "description": "Streamed text/plain token response (not the envelope). Tool-calling loop: `search_context` over the retrieval corpus plus the read-only market-data tools. Completed turns are persisted; the user's recent questions feed their private retrieval layer. Rate limited (ai tier).",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "messages"
                ],
                "properties": {
                  "messages": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "role": {
                          "type": "string",
                          "enum": [
                            "user",
                            "assistant"
                          ]
                        },
                        "content": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              },
              "example": {
                "messages": [
                  {
                    "role": "user",
                    "content": "How is my portfolio doing?"
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "A text token stream."
          },
          "400": {
            "description": "no_ai_key."
          },
          "401": {
            "description": "Not authenticated."
          },
          "422": {
            "description": "Invalid body."
          },
          "429": {
            "description": "Rate limited."
          }
        }
      },
      "delete": {
        "tags": [
          "AI"
        ],
        "summary": "Clear Mitra chat history",
        "description": "Deletes the caller's stored chat turns and drops their 'recent questions' entry from the retrieval corpus.",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "{ removed: <count> }"
          },
          "401": {
            "description": "Not authenticated."
          }
        }
      }
    },
    "/api/mcp": {
      "post": {
        "tags": [
          "Market data"
        ],
        "summary": "MCP server (JSON-RPC over Streamable HTTP)",
        "description": "The Model Context Protocol endpoint. Client config: { \"url\": \"https://<host>/api/mcp\" }. Requires header `Accept: application/json, text/event-stream`. Tools: search_symbols, get_quote, get_company_fundamentals, get_price_history, get_news, list_ipos, get_market_indices. Send `initialize`, then `tools/list` / `tools/call`. Public, rate limited (mcp tier).",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              },
              "example": {
                "jsonrpc": "2.0",
                "id": 1,
                "method": "tools/list",
                "params": {}
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "A JSON-RPC result (as an SSE `message` event or JSON, per the client's Accept header)."
          },
          "429": {
            "description": "Rate limited."
          }
        }
      }
    },
    "/api/cron/evaluate-alerts": {
      "post": {
        "tags": [
          "System"
        ],
        "summary": "Run one alert-evaluation cycle",
        "description": "Machine-to-machine. Bearer CRON_SECRET (dev-open, prod-503 when unset). No-ops outside NSE session hours unless ?force=1. Vercel Cron / GitHub Actions issue GET; both are accepted.",
        "security": [
          {
            "cronBearer": []
          }
        ],
        "parameters": [
          {
            "name": "force",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "1"
              ]
            },
            "description": "Bypass the market-hours gate."
          }
        ],
        "responses": {
          "200": {
            "description": "{ ran, fired, skippedNoData, errors, ... }"
          },
          "401": {
            "description": "Bad / missing bearer."
          },
          "503": {
            "description": "CRON_SECRET not set (production)."
          }
        }
      }
    },
    "/api/cron/agents-reflect": {
      "post": {
        "tags": [
          "System"
        ],
        "summary": "Reflect on finished agent runs (Phase 11 Part C)",
        "description": "Machine-to-machine. Bearer CRON_SECRET (dev-open, prod-503). For each `done` multi-agent run older than the reflection horizon (~21 days) with no reflection, writes a hindsight 'lessons' note comparing the debate's key claims to the stock's actual move, and prunes runs older than 120 days. `.github/workflows/agents-reflect.yml` calls it daily. Lessons are per-user and feed future runs.",
        "security": [
          {
            "cronBearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "{ considered, written, skipped, error, pruned, errors }"
          },
          "401": {
            "description": "Bad / missing bearer."
          },
          "503": {
            "description": "CRON_SECRET not set (production)."
          }
        }
      }
    },
    "/api/cron/index-corpus": {
      "post": {
        "tags": [
          "System"
        ],
        "summary": "Rebuild the shared retrieval corpus",
        "description": "Machine-to-machine (Phase 10 / ADR 0020). Bearer CRON_SECRET (dev-open, prod-503 when unset). Pulls recent news, chunks + embeds it locally, upserts into the `chunks` collection with userId=null, prunes stale news. GET and POST both accepted. `?indexesOnly=1` just ensures the collection + Atlas Vector Search indexes and returns.",
        "security": [
          {
            "cronBearer": []
          }
        ],
        "parameters": [
          {
            "name": "indexesOnly",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "1"
              ]
            },
            "description": "Ensure indexes only; do not index."
          },
          {
            "name": "newsLimit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1
            },
            "description": "How many recent news items to (re)consider (default 150)."
          }
        ],
        "responses": {
          "200": {
            "description": "{ vectorIndex, news: { seen, changed, pruned }, errors, ms }"
          },
          "401": {
            "description": "Bad / missing bearer."
          },
          "503": {
            "description": "CRON_SECRET not set (production)."
          }
        }
      }
    },
    "/api/portfolio-import/extract": {
      "post": {
        "tags": [
          "AI"
        ],
        "summary": "Extract proposed portfolio holdings from an uploaded file (ADR 0022)",
        "description": "Upload a broker screenshot (image), XLSX/CSV export, DOCX, or PDF statement. CSV/XLSX are parsed deterministically (no AI call); image/PDF/DOCX go through the caller's own AI key via structured output. Matches each extracted holding against the company database and diffs against the caller's existing holdings. Writes nothing \u2014 returns a proposed change list for the caller to review and separately approve via POST /api/portfolio-import/confirm.",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "file"
                ],
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "{ success: true, data: ProposedChange[] }"
          },
          "400": {
            "description": "no_ai_key (image/PDF/DOCX only)."
          },
          "401": {
            "description": "Not authenticated."
          },
          "422": {
            "description": "unreadable or no_holdings_found."
          },
          "429": {
            "description": "Rate limited."
          }
        }
      }
    },
    "/api/portfolio-import/confirm": {
      "post": {
        "tags": [
          "Portfolio"
        ],
        "summary": "Commit a reviewed portfolio import (ADR 0022)",
        "description": "Writes the user's explicitly approved subset of a POST /api/portfolio-import/extract response \u2014 the only route that actually creates/updates holdings from a Mitra-driven import. No AI involvement; a plain create-or-update per item. Never called automatically \u2014 reached only by an explicit approve action in the UI.",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "changes"
                ],
                "properties": {
                  "changes": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "matchedSymbol",
                        "action",
                        "existingHoldingId",
                        "after"
                      ],
                      "properties": {
                        "matchedSymbol": {
                          "type": "string"
                        },
                        "action": {
                          "type": "string",
                          "enum": [
                            "create",
                            "update"
                          ]
                        },
                        "existingHoldingId": {
                          "type": "string",
                          "nullable": true
                        },
                        "after": {
                          "type": "object",
                          "properties": {
                            "quantity": {
                              "type": "number"
                            },
                            "avgPrice": {
                              "type": "number"
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "{ success: true, data: { succeeded, failedSymbols } }"
          },
          "401": {
            "description": "Not authenticated."
          },
          "422": {
            "description": "Invalid request."
          },
          "429": {
            "description": "Rate limited."
          }
        }
      }
    }
  }
}
