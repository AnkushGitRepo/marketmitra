# Copy to .env and fill in for local development. .env is gitignored.

DATABASE_URL=postgresql+asyncpg://localhost/marketmitra_fundamentals
NSE_REQUESTS_PER_SECOND=3.0
TIER3_ENABLED=true
# Try the actual NSE/BSE results filing for financial statements before the
# Screener scrape (Phase 4 follow-up). false = financials come straight from Tier 3.
FINANCIALS_TIER1_ENABLED=true
LOG_LEVEL=INFO

# IPO tracker (ADR 0017) — shared secret the out-of-band refresh job
# (.github/workflows/refresh-ipos.yml) uses for POST /ipos/ingest. Leave
# empty locally; set it on the deployed service + as the CI repo secret.
IPO_INGEST_TOKEN=

# Screener quote and fundamentals ingest (ADR 0033). Invent a throwaway
# value and set the same string as SCREENER_INGEST_TOKEN in the app's
# .env.local. Do not copy the production secret. Empty = POST /screener/quotes
# and POST /screener/ingest answer 503.
SCREENER_INGEST_TOKEN=

# Fair-use rate limiting (Phase 9, ADR 0019) — HOSTED ONLY. Fixed-window
# per client IP via the Upstash Redis REST API. Empty = no-op pass-through
# (local dev / self-host is never throttled). On the deployed service, use
# the same Upstash instance the main app uses. Accepts the Vercel
# integration names (KV_REST_API_*) or the Upstash-native ones.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
RATE_LIMIT_PER_MINUTE=120
