# Copy to .env.local and fill in real values. .env.local is gitignored.

# Deployment mode: "hosted" or "selfhost". Defaults to "selfhost" when unset —
# a fresh clone with no config just runs with no login screen and no billing
# UI (single local user, straight into the dashboard). Only set this to
# "hosted" for MarketMitra's own paid deployment, where it turns on Clerk auth
# and the pricing/billing UI. Self-hosted users can leave this unset entirely.
# See ADR 0010.
NEXT_PUBLIC_DEPLOYMENT_MODE=selfhost

# MongoDB Atlas
MONGODB_URI=
MONGODB_DB=marketmitra

# Fundamentals data service (services/fundamentals-api, ADR 0011). Run it
# locally with `uvicorn app.main:app --port 8420` from that directory.
FUNDAMENTALS_API_URL=http://localhost:8420
# Shared secret between this app and the fundamentals-api for its
# server-to-server routes: POST /embed (retrieval embeddings, Phase 10) and
# POST /documents/extract-text. Set the SAME value on both. Without it,
# retrieval/RAG is disabled and chat/insights fall back to a summary.
IPO_INGEST_TOKEN=

# Alerts (Phase 5, ADR 0014) + corpus indexer (Phase 10, ADR 0020)
# CRON_SECRET guards POST /api/cron/evaluate-alerts AND
# POST /api/cron/index-corpus. Vercel Cron / GitHub Actions send it as a
# bearer token; self-hosters pass it themselves. When unset, the routes run
# in dev but are refused (503) in production.
CRON_SECRET=
# Optional external delivery — in-app notifications always work without this.
# ALERT_WEBHOOK_URL: a single URL every triggered alert is POSTed to
# (Telegram/Discord/Slack incoming webhooks work).
ALERT_WEBHOOK_URL=
# Email (Resend; also sends the one-time welcome email to new hosted users, ADR 0039). Set RESEND_API_KEY to turn it on; unset = in-app + webhook
# only. Self-host: ALERT_EMAIL_TO is the recipient. Hosted: the Clerk user's
# primary email. ALERT_EMAIL_FROM needs a Resend-verified domain for real
# multi-recipient sending; the default onboarding@resend.dev only reaches
# the Resend account owner (fine for a first test).
RESEND_API_KEY=
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=
# Footer line in designed emails (ADR 0040): sender name plus a real postal/contact address. Set it before any marketing send.
EMAIL_CONTACT_LINE=
# Where replies to our emails go (a mailbox you read). Optional; ALERT_EMAIL_FROM is usually send-only.
EMAIL_REPLY_TO=

# AI Insights (Phase 8, ADR 0018)
# SETTINGS_ENC_KEY encrypts the user's BYO AI provider key at rest (AES-256-GCM).
# 32 bytes, base64:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SETTINGS_ENC_KEY=
# Optional self-host / operator fallback: if a user hasn't set their own key,
# insights use these. AI_PROVIDER is gemini | anthropic | openrouter.
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=

# Rate limiting (Phase 9, ADR 0019) — HOSTED ONLY. If unset the limiter is a
# no-op pass-through, so self-host is never throttled. The Vercel Upstash
# integration injects KV_REST_API_URL / KV_REST_API_TOKEN; a manual setup can
# use the Upstash-native names below. Either is picked up.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Clerk (https://dashboard.clerk.com) — only required when DEPLOYMENT_MODE=hosted
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# --- Operator access (hosted only) ---------------------------------------------
# Comma-separated Clerk user ids allowed to see operator-only data (the System
# page's event log). Sign-up is open to anyone on a hosted instance, so being
# signed in is NOT enough. Unset = nobody can view the log (closed by default).
# Find your id in the Clerk dashboard, or in the browser console while signed in:
#   window.Clerk.user.id
# Not used when self-hosting — the single operator always has access.
ADMIN_USER_IDS=

# --- Screener bulk refresh (ADR 0033) ------------------------------------------
# Shared secret for fundamentals-api's POST /screener/quotes and /screener/ingest.
# Must equal SCREENER_INGEST_TOKEN on the fundamentals-api project. Used by
# POST /api/cron/refresh-screener-quotes (also guarded by CRON_SECRET).
SCREENER_INGEST_TOKEN=

# Mitra Advisor (local-only decision-support tool). Off unless set to exactly
# "enabled", and always refused when NEXT_PUBLIC_DEPLOYMENT_MODE=hosted.
ADVISOR_MODE=

# Daily cap on analyst AI calls per user. Ignored on the hosted site (fixed at 20). On a local or
# self-hosted instance the default is 200; set a whole number between 20 and 1000 to change it.
ANALYST_DAILY_AI_CAP=
